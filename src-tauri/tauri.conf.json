{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "shotkey",
  "version": "0.1.0",
  "identifier": "com.fixjp.shotkey",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "shotkey",
        "width": 620,
        "height": 760,
        "minWidth": 520,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
